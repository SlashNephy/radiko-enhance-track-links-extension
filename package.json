    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "jaconv": "1.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@slashnephy/eslint-config": "3.0.438",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@12.3.0"
}
